# Render one source README pair for each distribution layout.
# Links into the private/source repository are rewritten only for files that
# are actually shipped; source-only paragraphs are omitted from distributions.
function(contactglove_render_readmes layout output_dir)
    set(base "https://github.com/MeltInterfaceTechnologies/ContactGloveSDKv2Cpp/blob/main/")
    set(fake_root "${CMAKE_CURRENT_BINARY_DIR}/readme-layout")
    set(docdir "${CMAKE_INSTALL_DATAROOTDIR}/doc/${PROJECT_NAME}")
    set(examples "${CMAKE_INSTALL_DATAROOTDIR}/${PROJECT_NAME}/examples")
    if(layout STREQUAL "archive-root")
        set(doc_prefix "${docdir}/")
        set(example_prefix "${examples}/")
        set(rust_prefix "rust/")
    elseif(layout STREQUAL "install-doc" OR layout STREQUAL "archive-doc")
        set(doc_prefix "")
        file(RELATIVE_PATH example_prefix "${fake_root}/${docdir}" "${fake_root}/${examples}")
        string(APPEND example_prefix "/")
        if(layout STREQUAL "install-doc")
            file(RELATIVE_PATH rust_prefix "${fake_root}/${docdir}"
                "${fake_root}/${CMAKE_INSTALL_DATAROOTDIR}/${PROJECT_NAME}/rust")
        else()
            file(RELATIVE_PATH rust_prefix "${fake_root}/${docdir}" "${fake_root}/rust")
        endif()
        string(APPEND rust_prefix "/")
    else()
        message(FATAL_ERROR "Unknown README layout: ${layout}")
    endif()

    file(MAKE_DIRECTORY "${output_dir}")
    foreach(name README.md README_JA.md)
        file(READ "${CMAKE_CURRENT_SOURCE_DIR}/${name}" content)
        set(begin_marker "<!-- BEGIN SOURCE-ONLY -->")
        set(end_marker "<!-- END SOURCE-ONLY -->")
        string(FIND "${content}" "${begin_marker}" begin)
        while(NOT begin EQUAL -1)
            string(FIND "${content}" "${end_marker}" end)
            if(end LESS begin)
                message(FATAL_ERROR "Unmatched README source-only marker in ${name}")
            endif()
            string(LENGTH "${end_marker}" marker_length)
            math(EXPR after "${end} + ${marker_length}")
            string(SUBSTRING "${content}" 0 ${begin} prefix)
            string(SUBSTRING "${content}" ${after} -1 suffix)
            set(content "${prefix}${suffix}")
            string(FIND "${content}" "${begin_marker}" begin)
        endwhile()
        foreach(other README.md README_JA.md)
            string(REPLACE "${base}${other}" "${other}" content "${content}")
        endforeach()
        foreach(doc api.md LICENSE.md NOTICE.md THIRD_PARTY_NOTICES.md)
            string(REPLACE "${base}${doc}" "${doc_prefix}${doc}" content "${content}")
        endforeach()
        foreach(example basic_usage.cpp c_basic_usage.c)
            string(REPLACE "${base}examples/${example}" "${example_prefix}${example}" content "${content}")
        endforeach()
        foreach(rust_file README.md contactglove-sdk-v2/examples/basic_usage.rs)
            string(REPLACE "${base}bindings/rust/${rust_file}" "${rust_prefix}${rust_file}" content "${content}")
        endforeach()
        string(FIND "${content}" "${base}" leftover)
        string(FIND "${content}" "${end_marker}" unmatched_end)
        if(NOT leftover EQUAL -1 OR NOT unmatched_end EQUAL -1)
            message(FATAL_ERROR "Unmapped source link or marker in ${name}")
        endif()
        file(WRITE "${output_dir}/${name}" "${content}")
    endforeach()
endfunction()
